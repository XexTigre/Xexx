{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xextigre.github.io/roblox-3d-contract-brain/schemas/scoped_reaudit.schema.json",
  "title": "Scoped Roblox Reaudit Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "artifact",
    "pipeline_id",
    "requested_scope",
    "enforce_project_quality",
    "measurements",
    "component_manifest",
    "evidence",
    "review",
    "decision"
  ],
  "properties": {
    "contract_version": {"const": "1.3.0"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "pipeline_id": {
      "enum": ["avatar_setup_body_input", "r15_final_body", "dynamic_head", "rigid_accessory", "layered_accessory"]
    },
    "requested_scope": {
      "enum": ["container_parse", "gltf_spec_validation", "preservation", "avatar_setup_input_readiness", "r15_final_readiness", "studio_playtest", "ugc_marketplace"]
    },
    "enforce_project_quality": {"type": "boolean"},
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "container_parse_ok", "khronos_validator_status", "mesh_object_count",
        "connected_component_count", "classified_component_count", "unknown_component_count",
        "triangle_count", "boundary_edge_count", "unexpected_boundary_edge_count",
        "non_manifold_edge_count", "transform_identity", "front_axis", "up_axis", "pose",
        "centered_on_y_axis", "distinct_neck_status", "accessory_geometry_absent_status",
        "head_components_status", "texture_present", "body_part_mesh_count", "rig_present",
        "outer_cage_count", "attachment_count", "studio_import_status", "studio_playtest_status",
        "ugc_validation_status", "material_double_sided", "uv_gutter_px_2048",
        "uv_border_clearance_px_2048"
      ],
      "properties": {
        "container_parse_ok": {"type": "boolean"},
        "khronos_validator_status": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
        "mesh_object_count": {"type": "integer", "minimum": 0},
        "connected_component_count": {"type": "integer", "minimum": 0},
        "classified_component_count": {"type": "integer", "minimum": 0},
        "unknown_component_count": {"type": "integer", "minimum": 0},
        "triangle_count": {"type": "integer", "minimum": 0},
        "boundary_edge_count": {"type": "integer", "minimum": 0},
        "unexpected_boundary_edge_count": {"type": "integer", "minimum": 0},
        "non_manifold_edge_count": {"type": "integer", "minimum": 0},
        "transform_identity": {"type": "boolean"},
        "front_axis": {"enum": ["+Z", "-Z", "UNKNOWN"]},
        "up_axis": {"enum": ["+Y", "UNKNOWN"]},
        "pose": {"enum": ["A", "T", "I", "OTHER", "UNKNOWN"]},
        "centered_on_y_axis": {"type": "boolean"},
        "distinct_neck_status": {"enum": ["PASS", "FAIL", "BLOCKED"]},
        "accessory_geometry_absent_status": {"enum": ["PASS", "FAIL", "BLOCKED"]},
        "head_components_status": {"enum": ["PASS", "FAIL", "BLOCKED"]},
        "texture_present": {"type": "boolean"},
        "body_part_mesh_count": {"type": "integer", "minimum": 0},
        "rig_present": {"type": "boolean"},
        "outer_cage_count": {"type": "integer", "minimum": 0},
        "attachment_count": {"type": "integer", "minimum": 0},
        "studio_import_status": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
        "studio_playtest_status": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
        "ugc_validation_status": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
        "material_double_sided": {"type": "boolean"},
        "uv_gutter_px_2048": {"type": "number", "minimum": 0},
        "uv_border_clearance_px_2048": {"type": "number", "minimum": 0}
      }
    },
    "baseline_defects": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "default": []},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "path", "sha256", "artifact_sha256", "evidence_type", "subject_ids", "tool", "tool_version"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"},
          "artifact_sha256": {"$ref": "#/$defs/sha256"},
          "evidence_type": {"enum": ["mesh_audit_report", "khronos_report", "visual_board", "studio_import", "studio_playtest", "ugc_validation", "preservation_report"]},
          "subject_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "tool": {"type": "string", "minLength": 1},
          "tool_version": {"type": "string", "minLength": 1}
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator_id", "validator_id", "reviewer_id"],
      "properties": {
        "generator_id": {"type": "string", "minLength": 1},
        "validator_id": {"type": "string", "minLength": 1},
        "reviewer_id": {"type": "string", "minLength": 1}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manual_override"],
      "properties": {"manual_override": {"const": false}}
    },
    "component_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_id", "classification", "face_count", "boundary_edge_count", "allowed_open_boundary"],
        "properties": {
          "component_id": {"type": "string", "minLength": 1},
          "classification": {"enum": ["body_shell", "left_eye", "right_eye", "mouthbag", "upper_teeth", "lower_teeth", "tongue", "accessory", "clothing_geometry", "fragment", "unknown"]},
          "face_count": {"type": "integer", "minimum": 0},
          "boundary_edge_count": {"type": "integer", "minimum": 0},
          "allowed_open_boundary": {"type": "boolean"}
        }
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}

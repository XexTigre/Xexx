{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xextigre.local/schemas/cross_asset_contract.schema.json",
  "title": "Roblox Cross-Asset Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "pipeline_id", "artifact", "coordinates", "geometry", "evidence", "decision"],
  "properties": {
    "contract_version": {"const": "1.1.0"},
    "pipeline_id": {"enum": ["avatar_setup_body_input", "r15_final_body", "dynamic_head", "rigid_accessory", "layered_accessory"]},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "format", "byte_size"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "format": {"enum": ["glb", "gltf", "fbx"]},
        "byte_size": {"type": "integer", "minimum": 1}
      }
    },
    "coordinates": {
      "type": "object", "additionalProperties": false,
      "required": ["front_axis", "up_axis", "origin", "transforms_baked"],
      "properties": {
        "front_axis": {"enum": ["+Z", "-Z"]},
        "up_axis": {"const": "+Y"},
        "origin": {"enum": ["ground_center", "attachment_center", "roblox_origin"]},
        "transforms_baked": {"type": "boolean"}
      }
    },
    "geometry": {
      "type": "object", "additionalProperties": false,
      "required": ["render_mesh_count", "triangles_total", "watertight_status", "open_boundary_count", "non_manifold_edge_count"],
      "properties": {
        "render_mesh_count": {"type": "integer", "minimum": 1},
        "render_mesh_names": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "triangles_total": {"type": "integer", "minimum": 0},
        "triangle_groups": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "watertight_status": {"enum": ["PASS", "FAIL", "EXCEPTION_CLASSIFIED", "NOT_RUN"]},
        "open_boundary_count": {"type": "integer", "minimum": 0},
        "permitted_open_boundaries": {"type": "array", "items": {"enum": ["left_eye", "right_eye", "mouth"]}, "uniqueItems": true},
        "non_manifold_edge_count": {"type": "integer", "minimum": 0},
        "zero_area_triangle_count": {"type": "integer", "minimum": 0},
        "distinct_neck": {"type": "boolean"},
        "embedded_accessory_count": {"type": "integer", "minimum": 0},
        "head_components": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "eyes": {"type": "integer", "minimum": 0},
            "upper_teeth": {"type": "integer", "minimum": 0},
            "lower_teeth": {"type": "integer", "minimum": 0},
            "tongue": {"type": "integer", "minimum": 0},
            "components_share_forbidden_vertices": {"type": "boolean"}
          }
        }
      }
    },
    "rigging": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "present": {"type": "boolean"},
        "hierarchy_status": {"enum": ["PASS", "FAIL", "NOT_RUN", "NOT_APPLICABLE"]},
        "max_influences_observed": {"type": "integer", "minimum": 0},
        "root_influenced_vertex_count": {"type": "integer", "minimum": 0},
        "skinning_present": {"type": "boolean"},
        "weight_normalization_status": {"enum": ["PASS", "FAIL", "NOT_RUN", "NOT_APPLICABLE"]}
      }
    },
    "cages_attachments": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "outer_cage_count": {"type": "integer", "minimum": 0},
        "inner_cage_count": {"type": "integer", "minimum": 0},
        "attachment_count": {"type": "integer", "minimum": 0},
        "template_topology_status": {"enum": ["PASS", "FAIL", "NOT_RUN", "NOT_APPLICABLE"]},
        "template_uv_status": {"enum": ["PASS", "FAIL", "NOT_RUN", "NOT_APPLICABLE"]},
        "attachment_names_status": {"enum": ["PASS", "FAIL", "NOT_RUN", "NOT_APPLICABLE"]},
        "attachment_pose_status": {"enum": ["PASS", "FAIL", "NOT_RUN", "NOT_APPLICABLE"]}
      }
    },
    "dynamic_head": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "facs_pose_count": {"type": "integer", "minimum": 0},
        "landmarks": {
          "type": "object", "additionalProperties": false,
          "required": ["left_eye", "right_eye", "mouth"],
          "properties": {"left_eye": {"type": "boolean"}, "right_eye": {"type": "boolean"}, "mouth": {"type": "boolean"}}
        },
        "motion_tests": {
          "type": "object", "additionalProperties": false,
          "required": ["blink", "mouth_open", "happy", "sad"],
          "properties": {
            "blink": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
            "mouth_open": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
            "happy": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
            "sad": {"enum": ["PASS", "FAIL", "NOT_RUN"]}
          }
        }
      }
    },
    "textures": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "texture_count": {"type": "integer", "minimum": 0},
        "max_width": {"type": "integer", "minimum": 0},
        "max_height": {"type": "integer", "minimum": 0},
        "uv_status": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
        "material_status": {"enum": ["PASS", "FAIL", "NOT_RUN"]}
      }
    },
    "studio": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "import_status": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
        "playtest_status": {"enum": ["PASS", "FAIL", "NOT_RUN", "NOT_APPLICABLE"]},
        "ugc_validation_status": {"enum": ["PASS", "FAIL", "NOT_RUN", "NOT_APPLICABLE"]},
        "studio_version": {"type": "string"},
        "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["evidence_id", "kind", "path", "sha256", "artifact_sha256", "tool", "tool_version", "status", "independent_from_generator"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["parser_report", "geometry_report", "uv_report", "rig_report", "cage_report", "visual_render", "studio_import", "studio_playtest", "ugc_validation", "policy_review"]},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "tool": {"type": "string", "minLength": 1},
          "tool_version": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
          "independent_from_generator": {"type": "boolean"}
        }
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "manual_override", "computed_by"],
      "properties": {
        "status": {"enum": ["APPROVED", "REJECTED", "BLOCKED"]},
        "manual_override": {"const": false},
        "computed_by": {"type": "string", "minLength": 1},
        "reasons": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"pipeline_id": {"const": "avatar_setup_body_input"}}},
      "then": {
        "properties": {
          "coordinates": {"properties": {"front_axis": {"const": "-Z"}}},
          "geometry": {
            "required": ["distinct_neck", "embedded_accessory_count", "head_components"],
            "properties": {
              "triangles_total": {"maximum": 10742},
              "distinct_neck": {"const": true},
              "embedded_accessory_count": {"const": 0},
              "head_components": {
                "required": ["eyes", "upper_teeth", "lower_teeth", "tongue", "components_share_forbidden_vertices"],
                "properties": {
                  "eyes": {"const": 2},
                  "upper_teeth": {"minimum": 1},
                  "lower_teeth": {"minimum": 1},
                  "tongue": {"minimum": 1},
                  "components_share_forbidden_vertices": {"const": false}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"pipeline_id": {"const": "r15_final_body"}}},
      "then": {
        "required": ["rigging", "cages_attachments", "textures", "studio"],
        "properties": {
          "coordinates": {"properties": {"front_axis": {"const": "+Z"}, "transforms_baked": {"const": true}}},
          "geometry": {"properties": {"render_mesh_count": {"const": 15}, "triangles_total": {"maximum": 10742}, "watertight_status": {"const": "PASS"}, "open_boundary_count": {"const": 0}, "non_manifold_edge_count": {"const": 0}}},
          "rigging": {"required": ["present", "hierarchy_status", "max_influences_observed", "root_influenced_vertex_count", "skinning_present"], "properties": {"present": {"const": true}, "hierarchy_status": {"const": "PASS"}, "max_influences_observed": {"maximum": 4}, "root_influenced_vertex_count": {"const": 0}, "skinning_present": {"const": true}}},
          "cages_attachments": {"required": ["outer_cage_count", "attachment_count", "template_topology_status", "template_uv_status", "attachment_names_status", "attachment_pose_status"], "properties": {"outer_cage_count": {"const": 15}, "attachment_count": {"const": 19}, "template_topology_status": {"const": "PASS"}, "template_uv_status": {"const": "PASS"}, "attachment_names_status": {"const": "PASS"}, "attachment_pose_status": {"const": "PASS"}}},
          "textures": {"required": ["max_width", "max_height"], "properties": {"max_width": {"maximum": 2048}, "max_height": {"maximum": 2048}}},
          "studio": {"required": ["import_status", "playtest_status", "ugc_validation_status", "artifact_sha256"], "properties": {"import_status": {"const": "PASS"}, "playtest_status": {"const": "PASS"}, "ugc_validation_status": {"const": "PASS"}}}
        }
      }
    },
    {
      "if": {"properties": {"pipeline_id": {"const": "dynamic_head"}}},
      "then": {
        "required": ["dynamic_head", "cages_attachments", "studio"],
        "properties": {
          "dynamic_head": {"required": ["facs_pose_count", "landmarks", "motion_tests"], "properties": {"facs_pose_count": {"minimum": 17}}},
          "cages_attachments": {"required": ["outer_cage_count", "template_topology_status", "template_uv_status"], "properties": {"outer_cage_count": {"minimum": 1}, "template_topology_status": {"const": "PASS"}, "template_uv_status": {"const": "PASS"}}},
          "studio": {"required": ["ugc_validation_status", "artifact_sha256"], "properties": {"ugc_validation_status": {"const": "PASS"}}}
        }
      }
    },
    {
      "if": {"properties": {"pipeline_id": {"const": "rigid_accessory"}}},
      "then": {
        "required": ["rigging", "studio"],
        "properties": {
          "geometry": {"properties": {"render_mesh_count": {"const": 1}, "triangles_total": {"maximum": 4000}, "watertight_status": {"const": "PASS"}, "open_boundary_count": {"const": 0}}},
          "rigging": {"required": ["skinning_present"], "properties": {"skinning_present": {"const": false}}},
          "studio": {"required": ["import_status", "ugc_validation_status", "artifact_sha256"], "properties": {"import_status": {"const": "PASS"}, "ugc_validation_status": {"const": "PASS"}}}
        }
      }
    },
    {
      "if": {"properties": {"pipeline_id": {"const": "layered_accessory"}}},
      "then": {
        "required": ["rigging", "cages_attachments", "textures", "studio"],
        "properties": {
          "geometry": {"properties": {"render_mesh_count": {"const": 1}, "triangles_total": {"maximum": 4000}, "watertight_status": {"const": "PASS"}, "open_boundary_count": {"const": 0}}},
          "rigging": {"required": ["skinning_present"], "properties": {"skinning_present": {"const": true}}},
          "cages_attachments": {"required": ["outer_cage_count", "inner_cage_count", "attachment_count", "template_topology_status", "template_uv_status"], "properties": {"outer_cage_count": {"minimum": 1}, "inner_cage_count": {"minimum": 1}, "attachment_count": {"minimum": 1}, "template_topology_status": {"const": "PASS"}, "template_uv_status": {"const": "PASS"}}},
          "textures": {"required": ["max_width", "max_height"], "properties": {"max_width": {"maximum": 2048}, "max_height": {"maximum": 2048}}},
          "studio": {"required": ["import_status", "playtest_status", "ugc_validation_status", "artifact_sha256"], "properties": {"import_status": {"const": "PASS"}, "playtest_status": {"const": "PASS"}, "ugc_validation_status": {"const": "PASS"}}}
        }
      }
    }
  ]
}
